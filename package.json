{
  "name": "hse-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA for the Health & Safety Inspection Checklist",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "4.4.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "preact": "10.29.8",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "6.2.7",
    "typescript": "^5.6.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
